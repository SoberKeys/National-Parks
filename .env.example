# [PROJECT] — validation prototype environment
# Copy to app/.env.local and fill in real values. NEVER commit real values.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser (RLS enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses RLS. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use test keys (sk_test_ / pk_test_) until the money audit in docs/validation/PLAN.md §23 passes.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the three Completion Kit price cohorts (Amendment: $29 / $39 / $49)
STRIPE_PRICE_KIT_29=
STRIPE_PRICE_KIT_39=
STRIPE_PRICE_KIT_49=
# Founding Collector — $99 one-time, cap 250 enforced in the database
STRIPE_PRICE_FOUNDING_COLLECTOR=

# ─── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Error monitoring ────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Transactional email ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ─── NPS Data API ────────────────────────────────────────────────────────────
# Free key from https://www.nps.gov/subjects/developer/get-started.htm
# Sent as an Authorization request header, not a query string parameter.
NPS_API_KEY=

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gates challenge enrollment. MUST remain "false" until counsel approves the
# participant agreement — see docs/validation/PLAN.md §14 and ADR-0008.
NEXT_PUBLIC_ENROLLMENT_OPEN=false
# Admin console access — a shared secret is adequate for a 45-day internal tool.
ADMIN_ACCESS_TOKEN=
