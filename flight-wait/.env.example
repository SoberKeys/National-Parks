# Leaveby — every key is optional. With none set, the UI runs on its
# built-in simulation and labels every number "simulated".

PORT=3131

# ---- Flight status (first configured provider wins, others are fallbacks) ----
# AeroDataBox via RapidAPI — best gate/terminal coverage. https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_KEY=
# FlightAware AeroAPI. https://www.flightaware.com/aeroapi/
AEROAPI_KEY=
# AviationStack. https://aviationstack.com/
AVIATIONSTACK_KEY=

# ---- Security waits ----
# Your own or an airport's feed returning the normalised shape documented in
# server.mjs. {code} is replaced with the IATA code, e.g. https://feeds.example/waits/{code}
SECURITY_WAITS_URL=
SECURITY_WAITS_TOKEN=
# tsawaittimes.com (airport-wide figure). https://www.tsawaittimes.com/api
TSAWAITTIMES_KEY=
